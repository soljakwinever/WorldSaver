.player-menu { display: none; position: absolute; inset: 0; background-color: rgba(4, 7, 13, 0.78); align-items: center; justify-content: center; color: rgb(229, 234, 242); }
.player-menu__window { width: 86%; height: 84%; min-width: 760px; min-height: 520px; max-width: 1240px; background-color: rgb(21, 27, 38); border-width: 2px; border-color: rgb(104, 121, 145); border-radius: 10px; }
.player-menu__header { height: 58px; padding: 12px 20px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgb(13, 18, 27); }
.player-menu__title { font-size: 25px; -unity-font-style: bold; color: rgb(255, 211, 102); }
.player-menu__hint { color: rgb(155, 168, 188); font-size: 12px; }
.player-menu__tabs { height: 48px; flex-direction: row; background-color: rgb(16, 21, 31); padding-left: 18px; }
.player-menu__tab { width: 160px; border-width: 0 0 3px 0; border-bottom-color: rgba(0,0,0,0); background-color: rgba(0,0,0,0); color: rgb(170, 181, 198); -unity-font-style: bold; }
.player-menu__tab--active { color: white; border-bottom-color: rgb(255, 199, 75); background-color: rgb(29, 37, 51); }
.player-menu__body, .menu-page { flex-grow: 1; }
.menu-page { padding: 18px 22px; }
.section-title { font-size: 17px; -unity-font-style: bold; color: rgb(255, 207, 90); margin-bottom: 10px; }
.section-title--spaced { margin-top: 22px; }
.character-heading, .inventory-header { flex-direction: row; justify-content: space-between; align-items: center; }
.menu-progress { height: 18px; margin-bottom: 18px; }
.character-columns { flex-direction: row; flex-grow: 1; }
.menu-panel { flex-grow: 1; width: 50%; margin: 4px 8px; padding: 16px; background-color: rgb(27, 35, 48); border-radius: 7px; }
.data-row { min-height: 29px; flex-direction: row; justify-content: space-between; border-bottom-width: 1px; border-bottom-color: rgb(48, 59, 75); padding: 5px 4px; }
.stub-text { color: rgb(133, 145, 162); white-space: normal; }
.stub-text--center { -unity-text-align: middle-center; font-size: 20px; flex-grow: 1; }
.skills-page { flex-direction: row; }
.skills-left { width: 46%; padding-right: 18px; border-right-width: 1px; border-right-color: rgb(56, 67, 83); }
.skills-list { flex-grow: 1; margin-top: 8px; }
.skill-tree-stub { flex-grow: 1; padding-left: 22px; }
.skill-tree-header { height: 58px; flex-direction: row; align-items: center; justify-content: space-between; }
.skill-tree-heading { flex-grow: 1; align-items: center; }
.skill-tree-heading .section-title { margin-bottom: 1px; }
.skill-points { color: rgb(190, 205, 225); font-size: 12px; }
.skill-tree-arrow { width: 42px; height: 36px; font-size: 21px; -unity-font-style: bold; }
.skill-tree-scroll { flex-grow: 1; background-color: rgb(16, 21, 31); border-radius: 6px; }
.skill-tree-canvas { position: relative; min-width: 100%; min-height: 100%; }
.skill-tree-node { position: absolute; width: 68px; height: 68px; border-width: 2px; border-color: rgb(73, 86, 106); border-radius: 8px; background-color: rgb(29, 38, 52); padding: 5px; }
.skill-tree-node:hover { border-color: rgb(255, 210, 100); }
.skill-tree-node--available { border-color: rgb(110, 180, 235); }
.skill-tree-node--unlocked { border-color: rgb(255, 196, 70); background-color: rgb(54, 48, 31); }
.skill-tree-node__icon { width: 54px; height: 54px; align-self: center; }
.skill-category { margin: 14px 0 5px 2px; color: rgb(145, 182, 224); -unity-font-style: bold; }
.learned-skill { height: 82px; margin: 3px 0; padding: 8px; flex-direction: row; background-color: rgb(31, 40, 55); border-width: 1px; border-color: rgb(56, 68, 86); border-radius: 5px; }
.learned-skill:hover { background-color: rgb(43, 55, 73); border-color: rgb(255, 198, 75); }
.learned-skill__icon { width: 60px; height: 60px; margin-right: 12px; }
.learned-skill__details { flex-grow: 1; }
.learned-skill__name { font-size: 16px; -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: rgb(184, 193, 207); margin-bottom: 3px; }
.learned-skill__element { color: rgb(135, 180, 226); font-size: 12px; }
.inventory-page { padding: 22px 30px; }
.inventory-header { height: 55px; border-bottom-width: 1px; border-bottom-color: rgb(61, 72, 88); margin-bottom: 12px; }
.gold-value { font-size: 23px; color: rgb(255, 208, 76); -unity-font-style: bold; flex-grow: 1; margin-left: 14px; }
.inventory-capacity { color: rgb(155, 168, 188); }
.inventory-scroll { flex-grow: 1; }
.inventory-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.inventory-slot { width: 76px; height: 76px; margin: 5px; background-color: rgb(30, 38, 52); border-width: 1px; border-color: rgb(74, 86, 104); border-radius: 5px; }
.inventory-slot__icon { position: absolute; inset: 7px; }
.inventory-slot__count { position: absolute; right: 5px; bottom: 3px; color: white; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.universal-tooltip { position: absolute; width: 300px; padding: 10px; background-color: rgba(10, 14, 22, 0.97); border-width: 1px; border-color: rgb(99, 113, 136); border-radius: 6px; color: rgb(225, 231, 240); }
.universal-tooltip__header { flex-direction: row; align-items: center; }
.universal-tooltip__icon { width: 42px; height: 42px; margin-right: 9px; }
.universal-tooltip__name { flex-grow: 1; font-size: 16px; -unity-font-style: bold; }
.universal-tooltip__count { font-size: 14px; color: rgb(190, 199, 213); }
.universal-tooltip__description { margin-top: 7px; white-space: normal; color: rgb(190, 199, 213); }
